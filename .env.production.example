# ==============================================================================
# BusSense AI - Production Environment Configuration Template (.env.production)
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to '.env.production' on your secure production deployment host.
# 2. Never commit actual production secrets, passwords, or private keys to git.
# 3. All placeholder values enclosed in brackets '[...]' must be replaced.
# ==============================================================================

# Application Environment (Production constraints enforced server-side)
ENVIRONMENT=production
DEBUG=False
DEMO_MODE=False

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Cryptographic Secret Key for JWT Signing
# MUST be generated using a cryptographically secure RNG (e.g. `openssl rand -hex 32`)
# Minimum length: 32 characters. Must NOT contain default/prototype phrases.
SECRET_KEY=[REQUIRED_GENERATE_STRONG_RANDOM_SECRET_MINIMUM_32_CHARS]

# Dynamic CORS Allowed Origins (Comma-separated list of exact production domains)
# Prohibited: Wildcard '*' is strictly rejected when allow_credentials=True.
# Prohibited: Only-localhost origins are rejected when ENVIRONMENT=production.
ALLOWED_ORIGINS=https://bussense.kerala.gov.in,https://admin.bussense.kerala.gov.in

# Supabase Managed Database & PostgREST Configuration
# Region: ap-south-1 (Mumbai) / HTTPS enforced
SUPABASE_URL=https://[YOUR_SUPABASE_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]

# Supabase Service Role Key (Kept EXCLUSIVELY on trusted backend container)
# WARNING: NEVER expose this key in Next.js public bundles, Flutter assets, or logs.
# Required for elevated server-side procedures (e.g. atomic ticket validation).
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]

# Direct PostgreSQL Connection (Optional, for database migration runners)
DATABASE_URL=postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# Operational Telemetry & Simulation Parameters
SIMULATION_INTERVAL_SECONDS=2
DEFAULT_TRANSIT_CITY="Kochi, Kerala"

# Computer Vision Configuration
# In production with physical on-bus cameras, use REAL_VIDEO or streaming RTSP.
CV_MODE=SIMULATION
YOLO_MODEL_PATH=yolov8n.pt

# Payment Gateway Configuration
# Mode: SIMULATED (mock state machine) or RAZORPAY_LIVE (production credentials)
PAYMENT_GATEWAY_MODE=SIMULATED
RAZORPAY_KEY_ID=[OPTIONAL_RAZORPAY_LIVE_KEY_ID]
RAZORPAY_KEY_SECRET=[OPTIONAL_RAZORPAY_LIVE_KEY_SECRET]

# External Fallback Services (Optional)
AI_API_KEY=[OPTIONAL_EXTERNAL_LLM_KEY]
MAP_API_KEY=[OPTIONAL_MAP_TILE_PROVIDER_KEY]
