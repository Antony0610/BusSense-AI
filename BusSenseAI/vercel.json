{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/mobile_app",
      "destination": "/mobile_app/index.html"
    },
    {
      "source": "/mobile_app/",
      "destination": "/mobile_app/index.html"
    },
    {
      "source": "/app",
      "destination": "/mobile_app/index.html"
    },
    {
      "source": "/app/",
      "destination": "/mobile_app/index.html"
    }
  ]
}
